# Copy to .env.local and set a catalog you trust. Required for production builds.
# Development without a URL shows a configuration error and cannot connect/flash.
# Asset URLs must share the manifest origin; its server must permit CORS.
VITE_MANIFEST_URL=https://firmware.example.org/manifest.json

# Optional, development only: put these in .env.development.local instead.
# Paths are relative to this checkout (absolute paths also work). Nothing is bundled.
# VITE_MANIFEST_URL=/local-assets/manifest.json
# LOCAL_ASSET_MANIFEST=/path/to/private/releases/manifest.json
# LOCAL_ASSET_BASE_URL=https://firmware.example.org/manifest.json
# LOCAL_ASSET_IMAGE_ROOT=/path/to/images
# LOCAL_ASSET_PROGRAMMER=/path/to/programmer.bin
